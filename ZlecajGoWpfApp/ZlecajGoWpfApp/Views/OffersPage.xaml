<Page
    x:Class="ZlecajGoWpfApp.Views.OffersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:ZlecajGoApi.Dtos;assembly=ZlecajGoApi"
    xmlns:viewModel="clr-namespace:ZlecajGoWpfApp.ViewModels"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=viewModel:OffersViewModel,
                                     IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/EmptyDataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="ContainerMargin">10</Thickness>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition
                Width="*"
                MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <!--  Top button controls  -->
        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="{StaticResource ContainerMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Content="Kalendarz"
                    Command="{Binding OpenCalendarCommand}"
                    Style="{StaticResource HoverTriggerButton}"/>
                <Button
                    Grid.Column="1"
                    Content="Wiadomości"
                    Command="{Binding OpenMessagesCommand}"
                    Style="{StaticResource HoverTriggerButton}"/>
                <Button
                    Grid.Column="2"
                    Content="Konto"
                    Command="{Binding OpenAccountMenuWindowCommand}"
                    Style="{StaticResource HoverTriggerButton}"/>
                <Button
                    Grid.Column="3"
                    Command="{Binding LogOutCommand}"
                    Content="Wyloguj się"
                    Style="{StaticResource HoverTriggerButton}"/>
            </Grid>
        </materialDesign:Card>

        <!--  Left content - Map  -->
        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="0"
            Margin="{StaticResource ContainerMargin}">
            <Grid>
                <ContentControl Content="{Binding MapControl}"/>
                <Border Style="{StaticResource ProgressBarBorderDefaultStyle}">
                    <ProgressBar Style="{StaticResource ProgressBarDefaultStyle}"/>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!--  Right content - List of offers  -->
        <materialDesign:Card
            Grid.Row="1"
            Grid.Column="1"
            Margin="{StaticResource ContainerMargin}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--  Filter toggle button  -->
                <materialDesign:PopupBox
                    Grid.Row="0"
                    Margin="0,20,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    materialDesign:RippleAssist.IsDisabled="True"
                    PopupMode="Click"
                    StaysOpen="True">
                    <materialDesign:PopupBox.Effect>
                        <DropShadowEffect
                            BlurRadius="10"
                            ShadowDepth="0"/>
                    </materialDesign:PopupBox.Effect>
                    <materialDesign:PopupBox.ToggleContent>
                        <Grid>
                            <Ellipse
                                Width="50"
                                Height="50"
                                Fill="{StaticResource AccentColorBrush1}"/>
                            <materialDesign:PackIcon
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="Filter"/>
                        </Grid>
                    </materialDesign:PopupBox.ToggleContent>
                    <UniformGrid
                        Width="150"
                        Height="200"
                        Margin="10,-10"
                        Rows="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource RegularFontSize}"
                            Text="Filtruj oferty:"/>
                        <ComboBox
                            materialDesign:HintAssist.Hint="Typ"
                            DisplayMemberPath="Name"
                            IsReadOnly="True"
                            FontSize="{StaticResource RegularFontSize}"
                            ItemsSource="{Binding Types}"
                            SelectedItem="{Binding SelectedType}"/>
                        <ComboBox
                            materialDesign:HintAssist.Hint="Kategoria"
                            DisplayMemberPath="Name"
                            IsReadOnly="True"
                            FontSize="{StaticResource RegularFontSize}"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"/>
                        <ComboBox
                            materialDesign:HintAssist.Hint="Miasto"
                            IsReadOnly="True"
                            FontSize="{StaticResource RegularFontSize}"
                            ItemsSource="{Binding AvailableCities}"
                            SelectedItem="{Binding SelectedCity}"/>
                        <UniformGrid Columns="2">
                            <Button
                                Margin="0,0,5,0"
                                Command="{Binding FilterOffersCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <Button.Content>
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Kind="Check"/>
                                </Button.Content>
                            </Button>
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding ResetFilterOptionsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                                <Button.Content>
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Kind="Broom"/>
                                </Button.Content>
                            </Button>
                        </UniformGrid>
                    </UniformGrid>
                </materialDesign:PopupBox>

                <!--  No offers message  -->
                <ContentControl
                    Grid.Row="0"
                    ContentTemplate="{StaticResource NoOffersTemplate}"
                    DataContext="{Binding .}"
                    Visibility="{Binding AvailableOffersView.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!--  Offers list  -->
                <ListView
                    Grid.Row="0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding AvailableOffersView}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="model:OfferDto">
                            <materialDesign:Card
                                Height="250"
                                Padding="10"
                                Background="{StaticResource AccentColorsGradientBrush}">
                                <materialDesign:Card.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.ShowOfferDetailsCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CommandParameter="{Binding .}"
                                        MouseAction="LeftClick"/>
                                </materialDesign:Card.InputBindings>
                                <materialDesign:Card.ToolTip>Kliknij lewym przyciskiem myszy aby zobaczyć szczegóły ogłoszenia</materialDesign:Card.ToolTip>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height=".10*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height=".10*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height=".10*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height=".10*"/>
                                        <RowDefinition Height=".50*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="{StaticResource BigFontSize}"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding TypeName}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="{StaticResource MediumFontSize}"
                                        Foreground="White"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock
                                        Grid.Row="4"
                                        FontSize="{StaticResource RegularFontSize}"
                                        Foreground="White"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding Path="City"/>
                                                <Binding Path="Street"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Row="6"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource RegularFontSize}"
                                        Foreground="White"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"/>
                                    <materialDesign:Card Grid.Row="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource MediumFontSize}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource AccentColorBrush2}"
                                            Text="{Binding Price, StringFormat='{}{0} zł'}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                    </materialDesign:Card>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Style="{StaticResource ProgressBarBorderDefaultStyle}">
                    <ProgressBar Style="{StaticResource ProgressBarDefaultStyle}"/>
                </Border>

                <!--  Add offer button  -->
                <Border
                    Grid.Row="1"
                    Height="75"
                    Background="{StaticResource MaterialDesignBackground}">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="25"
                            Direction="270"
                            ShadowDepth="0"/>
                    </Border.Effect>
                    <Button
                        Command="{Binding OpenAddOfferFormCommand}"
                        Content="Dodaj zlecenie/usługę"
                        Style="{StaticResource HoverTriggerButton}"/>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>

</Page>
