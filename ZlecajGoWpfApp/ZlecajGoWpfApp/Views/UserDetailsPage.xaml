<Page
    x:Class="ZlecajGoWpfApp.Views.UserDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:viewModel="clr-namespace:ZlecajGoWpfApp.ViewModels"
    Width="800"
    Height="500"
    d:DataContext="{d:DesignInstance Type=viewModel:UserAccountMenuViewModel,
                                     IsDesignTimeCreatable=True}"
    IsEnabled="{Binding IsNotBusy}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="CenteredAlignmentStyle"
            TargetType="FrameworkElement">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style
            x:Key="OptionButton"
            TargetType="Button"
            BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColorBrush1}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush1}"/>
        </Style>
        <Style
            x:Key="BorderStyle"
            TargetType="Border">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColorBrush1}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style
            x:Key="TextBlockIcon"
            TargetType="materialDesign:PackIcon">
            <Setter Property="Foreground" Value="{StaticResource AccentColorBrush1}"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style
            x:Key="TextBlockText"
            TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource MediumFontSize}"/>
        </Style>
        <Style
            x:Key="TextBoxEditText"
            TargetType="TextBox"
            BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource MediumFontSize}"/>
        </Style>
        <Style
            x:Key="PasswordBoxEditText"
            TargetType="PasswordBox"
            BasedOn="{StaticResource MaterialDesignPasswordBox}">
            <Setter Property="FontSize" Value="{StaticResource RegularFontSize}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".75*"/>
            <RowDefinition Height=".20*"/>
            <RowDefinition Height=".75*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".20*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width=".20*"/>
            </Grid.ColumnDefinitions>
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Visibility="{Binding EditModeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding NavigateToUserMenuNavigationCommand}"
                Style="{StaticResource OptionButton}">
                <Button.Content>
                    <StackPanel
                        Style="{StaticResource CenteredAlignmentStyle}"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Kind="KeyboardBackspace"/>
                        <TextBlock
                            Margin="10,0,0,0"
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Text="Wróć"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding TurnOffEditModeCommand}"
                Style="{StaticResource OptionButton}"
                IsCancel="True">
                <Button.Content>
                    <StackPanel
                        Style="{StaticResource CenteredAlignmentStyle}"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Kind="ContentSaveOff"/>
                        <TextBlock
                            Margin="10,0,0,0"
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Text="Anuluj"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Visibility="{Binding EditModeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding TurnOnEditModeCommand}"
                Style="{StaticResource OptionButton}">
                <Button.Content>
                    <StackPanel
                        Orientation="Horizontal"
                        Style="{StaticResource CenteredAlignmentStyle}">
                        <TextBlock
                            Margin="0,0,10,0"
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Text="Edytuj"/>
                        <materialDesign:PackIcon
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Kind="Pencil"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding SaveChangesCommand}"
                Style="{StaticResource OptionButton}"
                IsDefault="True">
                <Button.Content>
                    <StackPanel
                        Orientation="Horizontal"
                        Style="{StaticResource CenteredAlignmentStyle}">
                        <TextBlock
                            Margin="0,0,10,0"
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Text="Zapisz"/>
                        <materialDesign:PackIcon
                            Style="{StaticResource CenteredAlignmentStyle}"
                            Kind="ContentSave"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <materialDesign:PackIcon
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Width="120"
                Height="120"
                Style="{StaticResource CenteredAlignmentStyle}"
                Kind="AccountCircle"/>
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CenteredAlignmentStyle}"
                FontWeight="Bold"
                FontSize="{StaticResource BigFontSize}"
                Text="{Binding CurrentUser.FullName}"/>
            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CenteredAlignmentStyle}"
                Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="0,0,10,0"
                    Style="{StaticResource CenteredAlignmentStyle}"
                    Kind="Cake"/>
                <TextBlock
                    Style="{StaticResource CenteredAlignmentStyle}"
                    FontSize="{StaticResource RegularFontSize}"
                    Text="{Binding CurrentUser.BirthDate, StringFormat='{}{0:dd MMMM yyyy}', ConverterCulture='pl-PL'}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height=".15*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="* Puste pola zostaną zignorowane"
                Foreground="Red"
                FontWeight="Bold"
                FontSize="{StaticResource SmallFontSize}"
                Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource BorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon
                        Grid.Row="0"
                        Style="{StaticResource TextBlockIcon}"
                        Kind="Email"/>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource TextBlockText}"
                        Text="{Binding CurrentUser.Email}"/>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource BorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon
                        Grid.Row="0"
                        Style="{StaticResource TextBlockIcon}"
                        Kind="TagText"/>
                    <TextBlock
                        Grid.Row="1"
                        Visibility="{Binding EditModeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TextBlockText}"
                        Text="{Binding CurrentUser.UserName}"/>
                    <TextBox
                        Grid.Row="1"
                        materialDesign:HintAssist.Hint="Nazwa użytkownika"
                        MaxLength="25"
                        Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TextBoxEditText}"
                        Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Grid.Column="4"
                Style="{StaticResource BorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon
                        Grid.Row="0"
                        Style="{StaticResource TextBlockIcon}"
                        Kind="CellphoneBasic"/>
                    <TextBlock
                        Grid.Row="1"
                        Visibility="{Binding EditModeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TextBlockText}"
                        Text="{Binding CurrentUser.PhoneNumber}"/>
                    <TextBox
                        Grid.Row="1"
                        materialDesign:HintAssist.Hint="Numer telefonu"
                        DataObject.Pasting="TextBox_OnPasting"
                        GotFocus="NewPhoneNumberTextBox_OnGotFocus"
                        LostFocus="NewPhoneNumberTextBox_OnLostFocus"
                        PreviewKeyDown="NewPhoneNumberTextBox_OnPreviewKeyDown"
                        PreviewTextInput="NewPhoneNumberTextBox_OnPreviewTextInput"
                        Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TextBoxEditText}"
                        Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Grid.Column="6"
                Style="{StaticResource BorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <materialDesign:PackIcon
                        Grid.Row="0"
                        Style="{StaticResource TextBlockIcon}"
                        Kind="KeyVariant"/>
                    <TextBlock
                        Grid.Row="1"
                        Visibility="{Binding EditModeDisabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource TextBlockText}"
                        Text="Podgląd hasła jest niedostępny"/>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,28"
                        VerticalAlignment="Center"
                        Orientation="Vertical"
                        Visibility="{Binding EditModeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <PasswordBox
                            materialDesign:HintAssist.Hint="Nowe hasło"
                            materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource PasswordBoxEditText}"/>
                        <PasswordBox
                            materialDesign:HintAssist.Hint="Potwierdź nowe hasło"
                            materialDesign:PasswordBoxAssist.Password="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource PasswordBoxEditText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Style="{StaticResource ProgressBarBorderDefaultStyle}">
            <ProgressBar Style="{StaticResource ProgressBarDefaultStyle}"/>
        </Border>
    </Grid>
</Page>
