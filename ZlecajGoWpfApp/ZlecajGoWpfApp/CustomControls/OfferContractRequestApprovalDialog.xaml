<customControls:BaseDialog
    x:Class="ZlecajGoWpfApp.CustomControls.OfferContractRequestApprovalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:customControls="clr-namespace:ZlecajGoWpfApp.CustomControls"
    Width="500"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <customControls:BaseDialog.Resources>
        <Style
            x:Key="ButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource MaterialDesignPaperButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </customControls:BaseDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel
            Grid.Row="0"
            VerticalAlignment="Center">
            <materialDesign:PackIcon
                Width="60"
                Height="60"
                Margin="20,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{StaticResource AccentColorBrush1}"
                Kind="Handshake"/>
            <TextBlock
                x:Name="Message"
                Margin="0,10,5,10"
                VerticalAlignment="Center"
                FontSize="{StaticResource MediumFontSize}"
                TextWrapping="Wrap"
                DockPanel.Dock="Right"/>
        </DockPanel>
        <DockPanel
            Grid.Row="1"
            Margin="10"
            VerticalAlignment="Center"
            LastChildFill="False">
            <Button
                Style="{StaticResource ButtonStyle}"
                DockPanel.Dock="Left"
                Background="Red"
                Click="RejectButton_Click"
                Content="Odrzuć"/>
            <Button
                Style="{StaticResource ButtonStyle}"
                DockPanel.Dock="Right"
                Background="Green"
                Click="AcceptButton_Click"
                Content="Zaakceptuj"/>
        </DockPanel>
    </Grid>
</customControls:BaseDialog>
