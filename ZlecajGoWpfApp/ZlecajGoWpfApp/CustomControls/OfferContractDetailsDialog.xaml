<customControls:BaseDialog
    x:Class="ZlecajGoWpfApp.CustomControls.OfferContractDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:customControls="clr-namespace:ZlecajGoWpfApp.CustomControls"
    xmlns:models="clr-namespace:ZlecajGoWpfApp.Models"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:converters="clr-namespace:ZlecajGoWpfApp.Converters"
    Title="Szczegóły"
    Width="500"
    Height="Auto"
    MinHeight="680"
    MaxHeight="720"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStyle="None"
    FontFamily="{DynamicResource MaterialDesignFont}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <Style
                x:Key="DetailKey"
                TargetType="Label"
                BasedOn="{StaticResource MaterialDesignLabel}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="{StaticResource RegularFontSize}"/>
            </Style>
            <Style
                x:Key="DetailValue"
                TargetType="TextBlock"
                BasedOn="{StaticResource MaterialDesignTextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource SmallFontSize}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <converters:OfferTypeToBrushConverter x:Key="OfferTypeToBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card
        Margin="20"
        Background="{StaticResource MaterialDesignPaper}">
        <materialDesign:Card.Effect>
            <DropShadowEffect
                BlurRadius="20"
                ShadowDepth="0"/>
        </materialDesign:Card.Effect>
        <Border
            BorderBrush="{Binding TypeId, Converter={StaticResource OfferTypeToBrushConverter}}"
            BorderThickness="10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <materialDesign:Card
                    Grid.Row="0"
                    Padding="0,5"
                    Background="{Binding TypeId, Converter={StaticResource OfferTypeToBrushConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="{StaticResource BigFontSize}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ({1})">
                                <Binding Path="TypeName"/>
                                <Binding Path="Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </materialDesign:Card>
                <ListView
                    x:Name="ListView"
                    Grid.Row="1"
                    Margin="0,10"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.ItemContainerStyle>
                        <Style
                            TargetType="ListViewItem"
                            BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="models:OfferContractDetails">
                            <Border Height="200">
                                <UniformGrid
                                    Rows="5"
                                    Columns="2">
                                    <Label
                                        Style="{StaticResource DetailKey}"
                                        Content="Właściciel:"/>
                                    <TextBlock Style="{StaticResource DetailValue}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}{2}">
                                                <Binding Path="ProviderFullName"/>
                                                <Binding Source="{x:Static system:Environment.NewLine}"/>
                                                <Binding Path="ProviderPhoneNumber"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Label
                                        Style="{StaticResource DetailKey}"
                                        Content="Wykonawca:"/>
                                    <TextBlock Style="{StaticResource DetailValue}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}{1}{2}">
                                                <Binding Path="ExecutorFullName"/>
                                                <Binding Source="{x:Static system:Environment.NewLine}"/>
                                                <Binding Path="ExecutorPhoneNumber"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Label
                                        Style="{StaticResource DetailKey}"
                                        Content="Tytuł:"/>
                                    <TextBlock
                                        Style="{StaticResource DetailValue}"
                                        Text="{Binding Title}"/>
                                    <Label
                                        Style="{StaticResource DetailKey}"
                                        Content="Data rozpoczęcia:"/>
                                    <TextBlock
                                        Style="{StaticResource DetailValue}"
                                        Text="{Binding StartDateTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                    <Label
                                        Style="{StaticResource DetailKey}"
                                        Content="Lokalizacja:"/>
                                    <TextBlock Style="{StaticResource DetailValue}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}{2}{3}">
                                                <Binding Path="ZipCode"/>
                                                <Binding Path="City"/>
                                                <Binding Source="{x:Static system:Environment.NewLine}"/>
                                                <Binding Path="Street"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </UniformGrid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    Grid.Row="2"
                    Click="CloseWindow"
                    Style="{StaticResource HoverTriggerButton}"
                    Content="Zamknij"/>
            </Grid>
        </Border>
    </materialDesign:Card>
</customControls:BaseDialog>
