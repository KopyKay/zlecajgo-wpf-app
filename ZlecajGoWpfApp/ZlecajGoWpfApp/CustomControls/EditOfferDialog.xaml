<customControls:BaseDialog
    x:Class="ZlecajGoWpfApp.CustomControls.EditOfferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:customControls="clr-namespace:ZlecajGoWpfApp.CustomControls"
    Title="Edycja ogłoszenia"
    Width="370"
    Height="225"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <customControls:BaseDialog.Resources>
        <DataTemplate x:Key="DurationInDaysTemplate">
            <TextBlock Text="{Binding Converter={StaticResource DurationInDaysConverter}}"/>
        </DataTemplate>
    </customControls:BaseDialog.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon
            Grid.Row="0"
            Grid.Column="0"
            Width="60"
            Height="60"
            Margin="5,0,15,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource AccentColorBrush1}"
            Kind="PencilCircle"/>
        <UniformGrid
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,-15,0,0"
            Rows="2">
            <ComboBox
                x:Name="DurationComboBox"
                Height="46"
                materialDesign:HintAssist.Hint="Skróć czas trwania ogłoszenia do"
                materialDesign:HintAssist.IsFloating="True"
                IsReadOnly="True"
                SelectedItem="{Binding SelectedDuration, RelativeSource={RelativeSource AncestorType=Window}}"
                FontSize="{StaticResource RegularFontSize}"
                ItemTemplate="{StaticResource DurationInDaysTemplate}"/>
            <TextBox
                Height="46"
                materialDesign:HintAssist.Hint="Wynagrodzenie (zł)"
                materialDesign:HintAssist.IsFloating="True"
                FontSize="{StaticResource RegularFontSize}"
                Text="{Binding NewOfferPrice, RelativeSource={RelativeSource AncestorType=Window}}"
                DataObject.Pasting="TextBox_OnPasting"
                LostFocus="PriceTextBox_LostFocus"
                PreviewKeyDown="PriceTextBox_OnPreviewKeyDown"
                PreviewTextInput="PriceTextBox_PreviewTextInput"/>
        </UniformGrid>
        <UniformGrid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,20,0,0"
            Columns="2">
            <Button
                Width="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsCancel="True"
                Content="Anuluj"
                Click="CancelButton_OnClick"/>
            <Button
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsDefault="True"
                Content="Potwierdź"
                Click="ConfirmButton_OnClick"/>
        </UniformGrid>
    </Grid>
</customControls:BaseDialog>
