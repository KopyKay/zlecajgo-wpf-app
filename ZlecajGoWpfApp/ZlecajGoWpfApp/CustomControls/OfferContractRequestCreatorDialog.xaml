<customControls:BaseDialog
    x:Class="ZlecajGoWpfApp.CustomControls.OfferContractRequestCreatorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:model="clr-namespace:ZlecajGoApi.Dtos;assembly=ZlecajGoApi"
    xmlns:customControls="clr-namespace:ZlecajGoWpfApp.CustomControls"
    Width="350"
    SizeToContent="Height"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    WindowStyle="None"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <customControls:BaseDialog.Resources>
        <Style
            x:Key="HeaderTextBox"
            TargetType="TextBlock"
            BasedOn="{StaticResource MaterialDesignTextBlock}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="{StaticResource AccentColorBrush1}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </customControls:BaseDialog.Resources>

    <materialDesign:Card
        Margin="20"
        Background="{StaticResource MaterialDesignBackground}">
        <materialDesign:Card.Effect>
            <DropShadowEffect
                BlurRadius="20"
                ShadowDepth="0"/>
        </materialDesign:Card.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    Style="{StaticResource HeaderTextBox}"
                    FontWeight="Bold"
                    Text="Tworzenie zgłoszenia dla"
                    FontSize="{StaticResource MediumFontSize}"/>
                <TextBlock
                    x:Name="PartnerFullNameTextBox"
                    Style="{StaticResource HeaderTextBox}"
                    FontSize="{StaticResource RegularFontSize}"/>
            </StackPanel>

            <!--  Content  -->
            <StackPanel
                Grid.Row="1"
                Margin="10,15">
                <StackPanel>
                    <ComboBox
                        x:Name="OffersComboBox"
                        Margin="0,0,0,25"
                        materialDesign:HintAssist.Hint="Wybierz zlecenie/usługę"
                        FontSize="{StaticResource RegularFontSize}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="model:OfferDto">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} - {1} ({2:dd.MM.yyyy})">
                                            <Binding Path="TypeName"/>
                                            <Binding Path="Title"/>
                                            <Binding Path="PostDateTime"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <UniformGrid Columns="2">
                        <DatePicker
                            xmlns:system="clr-namespace:System;assembly=mscorlib"
                            x:Name="DatePicker"
                            Margin="0,0,5,0"
                            materialDesign:HintAssist.Hint="Data"
                            DisplayDateStart="{x:Static system:DateTime.Today}"
                            FontSize="{StaticResource RegularFontSize}"/>
                        <materialDesign:TimePicker
                            x:Name="TimePicker"
                            Margin="5,0,0,0"
                            materialDesign:HintAssist.Hint="Godzina"
                            Is24Hours="True"
                            FontSize="{StaticResource RegularFontSize}"/>
                    </UniformGrid>
                </StackPanel>
                <TextBlock
                    x:Name="ValidationMessageTextBlock"
                    Margin="0,10,0,-15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    FontStyle="Italic"
                    FontSize="{StaticResource SmallFontSize}"
                    Foreground="Red"
                    Visibility="Collapsed"/>
            </StackPanel>

            <!--  Buttons  -->
            <StackPanel
                Grid.Row="2"
                Margin="10">
                <Button
                    Margin="0,0,0,10"
                    Content="Wyślij prośbę o akceptację"
                    Click="SendRequestButton_Click"/>
                <Button
                    Content="Anuluj"
                    BorderBrush="Red"
                    Foreground="Red"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</customControls:BaseDialog>
